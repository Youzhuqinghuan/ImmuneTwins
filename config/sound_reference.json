  },
  "seed": 42,
  "lambda_grid": [
    0.25,
    0.5,
    1,
    2,
    4,
    8,
    16,
    32,
    64,
    "inf"
  ],
  "response_scale_bounds": [
    0,
    1.25
  ],
  "lineage_return_bounds": [
    0,
    1
  ],
  "lineage_return_selection": "positive_inner_donor_mmd_gain_with_95_percent_interval_above_zero",
  "bootstrap_draws": 10000,
  "resting_visits": [
    "Flu Year 1 Day 0",
    "Flu Year 2 Day 0",
    "Flu Year 1 Day 90",
    "Flu Year 2 Day 90",
    "Immune Variation Day 0",
    "Immune Variation Day 7",
    "Immune Variation Day 90",
    "Flu Year 1 Stand-Alone",
    "Flu Year 2 Stand-Alone",
    "Flu Year 3 Stand-Alone"
  ],
  "inner_root": "${REPO}/results/sound_reference/inner",
  "reference_predictions": "${REPO}/results/sound_reference/predictions"
