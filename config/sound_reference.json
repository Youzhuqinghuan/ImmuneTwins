{
  "schema_version": "sound_personal_reference_1",
  "prepared_root": "${REPO}/artifacts/sound_reference",
  "output_root": "${REPO}/results/sound_reference",
  "inputs": {
    "visit_metadata": "${EXTERNAL}/data/manifests/sound_visit_manifest.tsv",
    "task_units": "${FROZEN_RESULTS}/baselines/vaccine_v2/vaccine_task_units.tsv",
    "outer_splits": "${WORKSPACE}/vaccine_baseline_runtime/config/splits/sound_outer_groupkfold5_donors.tsv",
    "inner_splits": "${WORKSPACE}/vaccine_baseline_runtime/config/splits/sound_inner_groupkfold4_donors.tsv",
    "latents": "${WORKSPACE}/vaccine_baseline_runtime/latents/outer{fold}_{role}.h5",
    "scales": "${WORKSPACE}/vaccine_baseline_runtime/scales/outer{fold}_all.npz",
    "visit_manifest": "${WORKSPACE}/artifacts/ImmuneTwins/vaccine_immunetwin_v1/features/visit_features_489.tsv",
    "sealed_source": "${WORKSPACE}/artifacts/ImmuneTwins/vaccine_bridge/source_visits_seed42.tsv",
    "sealed_uce": "${WORKSPACE}/artifacts/ImmuneTwins/vaccine_bridge/uce_features_seed42.h5",
    "cima": "${CIMA_CHECKPOINT}"
  },
  "neural_runs": {
