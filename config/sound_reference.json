    "current": "${FROZEN_RESULTS}/vaccine_immunetwin_v2/formal_projected_set_v0_1_seed42/current/{task}/outer{fold}_seed42",
    "history_t2": "${FROZEN_RESULTS}/vaccine_immunetwin_v2/formal_meta_adapter_v1_seed42/{task}/outer{fold}_seed42",
